{
  "expo": {
    "name": "Artha",
    "slug": "artha-finance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/splash_logo_round.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash_logo_round.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0C12"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash_logo_round.png",
        "backgroundColor": "#0C0C12"
      },
      "package": "com.artha.finance",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-notifications",
      "expo-secure-store"
    ]
  }
}